{
  "name": "NearBuyGoods — find it near you",
  "short_name": "NearBuyGoods",
  "description": "Upload any item. Find it at stores near you. Instantly.",
  "id": "/",
  "start_url": "/#/home",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#232c5c",
  "theme_color": "#232c5c",
  "categories": ["shopping", "lifestyle", "navigation"],
  "icons": [
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Find an item", "url": "/#/upload", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Saved & watchlist", "url": "/#/saved", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }] }
  ]
}
