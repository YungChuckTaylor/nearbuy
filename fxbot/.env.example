# Copy to .env (and keep it out of git). Everything here is optional except the
# token, which you only need for live trading / account data.

# --- Deriv -------------------------------------------------------------------
# Get an app_id at https://api.deriv.com/dashboard (1089 is Deriv's public
# sample id -- fine for experiments, register your own for anything serious).
DERIV_APP_ID=1089
# API token from deriv.com -> Settings -> Security -> API token.
# Scopes: Read + Trade. NEVER commit this.
DERIV_API_TOKEN=
DERIV_CURRENCY=USD

# --- Strategy ----------------------------------------------------------------
FXBOT_SYMBOLS=frxEURUSD,frxGBPUSD,frxUSDJPY,frxAUDUSD
FXBOT_GRANULARITY=900

# --- Runtime -----------------------------------------------------------------
FXBOT_MODE=paper            # paper | live
FXBOT_CONFIG=fxbot/config.json
FXBOT_LOG_LEVEL=INFO
# Paper equity used for position sizing when not reading a real balance
FXBOT_PAPER_EQUITY=10000

# --- Remote state (serverless only) -------------------------------------------
# Upstash Redis / Vercel KV REST endpoint. Leave blank to use data/fxbot/state.json
FXBOT_STATE_URL=
FXBOT_STATE_TOKEN=
FXBOT_STATE_KEY=fxbot:state

# --- Serverless cron auth ------------------------------------------------------
CRON_SECRET=
