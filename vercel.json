{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/handler.js": {
      "includeFiles": "{docs/**,seed/**,website/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
    }
  ],
  "rewrites": [
    { "source": "/:path*", "destination": "/api/handler" }
  ]
}
